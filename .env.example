# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Ключ Ollama Cloud (создаётся на https://ollama.com/settings/keys, без карты и телефона)
OLLAMA_API_KEY=

# Базовый URL Ollama Cloud. ВАЖНО: https://ollama.com, не api.ollama.com.
OLLAMA_BASE=https://ollama.com

# Модель по умолчанию
OLLAMA_MODEL=minimax-m3

# Модели в выпадашке, через запятую. Пусто = minimax-m3,gpt-oss:120b,nemotron-3-ultra
# Бесплатные на Ollama Cloud; kimi-k3, deepseek-v4-* требуют подписки.
OLLAMA_MODELS=

# OpenRouter: ключ с https://openrouter.ai/keys (нужен только если добавляете модели оттуда)
# OPENROUTER_API_KEY=
# Модели OpenRouter в выпадашке (бесплатные, с суффиксом :free)
# OPENROUTER_MODELS=poolside/laguna-s-2.1:free

# Лимит ответа модели и глубина контекста (число реплик)
CHAT_MAX_TOKENS=2048
CHAT_HISTORY_LIMIT=20

# Длина одной порции ответа (символов). Длинные ответы режутся на части с кнопкой «Далее ▸».
CHAT_CHUNK_SIZE=3500

# Таймаут запроса к провайдеру, сек
TIMEOUT=600

# Веб-поиск (встроен в Ollama, отдельный ключ не нужен)
# AGENT_MAX_ITERS=4          # максимум шагов поиска за один вопрос
# WEB_SEARCH_RESULTS=5       # результатов в выдаче
# WEB_SEARCH_SNIPPET=2000    # символов текста из каждой страницы
